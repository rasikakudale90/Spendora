{
  "info": {
    "_postman_id": "spendora-collection-v1",
    "name": "Spendora API",
    "description": "REST API test suite for Spendora V1–V3 (Expenses, Analytics, Budgets)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/expenses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Grocery Shopping\",\n  \"amount\": 1500.00,\n  \"category\": \"FOOD\",\n  \"expenseDate\": \"2026-08-22\",\n  \"description\": \"Weekly groceries\"\n}"
            }
          }
        },
        {
          "name": "Get All Expenses (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses?page=0&size=10&sortBy=expenseDate&sortDir=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "expenseDate" },
                { "key": "sortDir", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Search + Filter Expenses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses?search=grocery&category=FOOD&startDate=2026-08-01&endDate=2026-08-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses"],
              "query": [
                { "key": "search", "value": "grocery" },
                { "key": "category", "value": "FOOD" },
                { "key": "startDate", "value": "2026-08-01" },
                { "key": "endDate", "value": "2026-08-31" }
              ]
            }
          }
        },
        {
          "name": "Get Expense by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}"
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Expense\",\n  \"amount\": 2000.00,\n  \"category\": \"FOOD\",\n  \"expenseDate\": \"2026-08-22\"\n}"
            }
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics (This Month)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics?startDate=2026-08-01&endDate=2026-08-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics"],
              "query": [
                { "key": "startDate", "value": "2026-08-01" },
                { "key": "endDate", "value": "2026-08-31" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Budgets",
      "item": [
        {
          "name": "Create Budget",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/budgets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monthly Budget\",\n  \"category\": null,\n  \"periodStart\": \"2026-08-01\",\n  \"periodEnd\": \"2026-08-31\",\n  \"limitAmount\": 50000.00\n}"
            }
          }
        },
        {
          "name": "Get All Budgets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/budgets"
          }
        },
        {
          "name": "Get Budget Progress (All)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/budgets/progress"
          }
        },
        {
          "name": "Get Budget Progress by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/budgets/{{budgetId}}/progress"
          }
        },
        {
          "name": "Update Budget",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/budgets/{{budgetId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Monthly Budget\",\n  \"category\": null,\n  \"periodStart\": \"2026-08-01\",\n  \"periodEnd\": \"2026-08-31\",\n  \"limitAmount\": 60000.00\n}"
            }
          }
        },
        {
          "name": "Delete Budget",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/budgets/{{budgetId}}"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Actuator Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        }
      ]
    }
  ]
}
